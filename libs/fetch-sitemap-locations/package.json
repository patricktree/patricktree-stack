{
  "name": "@patricktree/fetch-sitemap-locations",
  "version": "1.1.0",
  "homepage": "https://github.com/patricktree/packages/tree/main/packages/fetch-sitemap-locations",
  "bugs": {
    "url": "https://github.com/patricktree/packages/issues"
  },
  "license": "MIT",
  "author": "Patrick Kerschbaum <patrick.kerschbaum@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/patricktree/packages",
    "directory": "packages/fetch-sitemap-locations"
  },
  "files": [
    "bin/**",
    "dist/**",
    "!dist/**/*.d.ts.map"
  ],
  "type": "module",
  "imports": {
    "#pkg/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": null
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.1.0",
    "commander": "^13.1.0",
    "tiny-invariant": "^1.3.3",
    "xml2js": "^0.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@types/node": "catalog:",
    "@types/xml2js": "^0.4.14",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
