{
  /* based on https://patricktree.me/tidbits/sensible-tsconfig-defaults?version-tab=TS+6.0+Node.js and https://github.com/tsconfig/bases/blob/270039fbe015427858d03d84a8549d113aac0b76/bases/node24.json */

  "compilerOptions": {
    /* Modules */
    "module": "Node20",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "types": ["node"],

    /* Language and Environment */
    "target": "ES2024"
  }
}
