{
  "extends": [
    "@patricktree-stack/config-typescript/tsconfig.defaults.json",
    "@patricktree-stack/config-typescript/tsconfig.typescript-execution-via-type-stripping.json"
  ],
  "compilerOptions": {
    /* Modules */
    "rootDir": "./test",
    "types": ["node"],

    /* Tests run through node:test and are only type-checked, so disable emit (as tsconfig.vitest.json does for Vitest packages). */
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "sourceMap": false,
    "composite": false
  },
  "include": ["test/**/*", "**/*.test.ts"],
  "references": [{ "path": "./tsconfig.build.json" }]
}
